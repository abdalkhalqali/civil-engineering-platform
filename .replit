modules = ["rust-stable", "bash", "python-base-3.13", "nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["lld"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Flutter Web Preview"

[[workflows.workflow]]
name = "Flutter Web Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./scripts/start_flutter_web.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
